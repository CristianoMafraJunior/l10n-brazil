<odoo>
    <record id="nfse_dfe_res_company_form" model="ir.ui.view">
        <field name="name">nfse.dfe.res.company.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_br_fiscal.fiscal_res_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='fiscal']/notebook" position="inside">
                <page name="nfse_dfe" string="NFS-e DF-e (ADN)">
                    <group name="nfse_dfe_settings" string="Configurações ADN">
                        <group>
                            <field name="nfse_environment" required="1" />
                        </group>
                        <group>
                            <field name="nfse_auto_fetch" />
                        </group>
                    </group>
                    <group name="nfse_dfe_last_query" string="Última Consulta">
                        <group>
                            <field name="nfse_last_nsu" />
                            <field name="nfse_max_nsu" />
                            <field
                                name="nfse_dfe_last_query"
                                string="Data"
                                readonly="1"
                                widget="datetime"
                            />
                        </group>
                        <group>
                            <field
                                name="nfse_dfe_last_status"
                                string="Status"
                                readonly="1"
                            />
                            <field
                                name="nfse_dfe_last_status_code"
                                string="Código de Status"
                                readonly="1"
                            />
                            <field
                                name="nfse_dfe_next_query"
                                string="Próxima Consulta"
                                readonly="1"
                                widget="datetime"
                            />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
